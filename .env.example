# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# Everything below is OPTIONAL in the sense that the app degrades gracefully
# without it (see CLAUDE.md — LLM falls back to a templated explanation,
# Telegram alerts fall back to local logging). Nothing crashes on a missing key.

# Groq API (free tier) — powers the LLM interpreter / chat (Llama 3.3 70B)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Telegram bot — created via @BotFather on Telegram
# 1. Message @BotFather -> /newbot -> follow prompts -> copy the token below
# 2. Message your new bot once, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
